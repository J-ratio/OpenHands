{
  "name": "openhands-add-to-chat",
  "displayName": "OpenHands Add to Chat",
  "description": "Add selected code to H2Loop chat",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:h2loop.addToChat"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "h2loop.addToChat",
        "title": "Add to Chat",
        "category": "h2Loop"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "h2loop.addToChat",
          "when": "editorIsOpen"
        }
      ],
      "editor/context": [
        {
          "command": "h2loop.addToChat",
          "when": "editorHasSelection",
          "group": "h2loop_addtochat"
        }
      ]
    },
    "keybindings": [
      {
        "command": "h2loop.addToChat",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus && editorHasSelection"
      }
    ]
  }
}
